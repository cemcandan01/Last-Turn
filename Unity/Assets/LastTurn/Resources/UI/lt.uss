/* Last Turn F arayüzü (docs/tasarim/ekranlar-f.html). Ölçüler 1920×1080 başvuru çözünürlüğünde piksel.
   Tek vurgu turuncu #ff7a3c, uyarı sarı #ffd27a; paneller koyu cam; eğik tuşların zemini Skew öğesince çizilir. */

.lt-kok {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    color: rgb(238, 242, 244);
    font-size: 18px;
}

.katman {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.gizli {
    display: none;
}

/* yazı aileleri */
.dar {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
}

.dar-yari {
    -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf");
}

.dar-italik {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
}

.dar-italik-ince {
    -unity-font-definition: url("Fonts/BarlowCondensed-BoldItalic.ttf");
}

.govde {
    -unity-font-definition: url("Fonts/Barlow-Regular.ttf");
}

.govde-orta {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
}

.govde-kalin {
    -unity-font-definition: url("Fonts/Barlow-SemiBold.ttf");
}

.golge {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
}

.golge-guclu {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
}

.soluk {
    color: rgb(152, 164, 174);
}

.vurgu {
    color: rgb(255, 122, 60);
}

.uyari {
    color: rgb(255, 210, 122);
}

/* klavye tuşu */
.t {
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.07);
    -unity-font-definition: url("Fonts/Barlow-SemiBold.ttf");
    font-size: 15px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    margin: 0;
}

.ipuclari {
    position: absolute;
    right: 58px;
    bottom: 28px;
    flex-direction: row;
    align-items: center;
}

.ipucu {
    flex-direction: row;
    align-items: center;
    margin-left: 28px;
}

.ipucu > .t {
    margin-right: 6px;
}

.ipucu > Label.yazi {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    font-size: 17px;
    color: rgb(219, 226, 231);
    margin-left: 2px;
}

/* eğik tuş (Skew zemini + yazı + isteğe bağlı tuş) */
.ltb {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 62px;
    padding: 0 34px;
    flex-shrink: 0;
}

.ltb > .skew {
    --fill: rgba(11, 20, 24, 0.86);
    --edge: rgba(255, 255, 255, 0.13);
}

.ltb:hover > .skew {
    --fill: rgba(30, 38, 44, 0.94);
    --edge: rgb(255, 122, 60);
}

.ltb > Label.yazi {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
    margin: 0 12px 0 0;
}

.ltb > .t {
    margin-left: 2px;
}

.ltb.ana > .skew {
    --fill: rgb(255, 122, 60);
    --edge: rgba(255, 176, 112, 0.9);
}

.ltb.ana:hover > .skew {
    --fill: rgb(255, 146, 92);
    --edge: rgb(255, 214, 190);
}

.ltb.ana > Label.yazi {
    color: rgb(26, 13, 5);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.ltb.ana > .t {
    color: rgb(26, 13, 5);
    border-color: rgba(26, 13, 5, 0.5);
    background-color: rgba(255, 255, 255, 0.2);
}

.ltb.kucuk {
    height: 48px;
    padding: 0 22px;
}

.ltb.kucuk > Label.yazi {
    font-size: 19px;
}

.ltb.kapali {
    opacity: 0.45;
}

/* üst şerit */
.ustbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 123px;
    flex-direction: row;
    align-items: center;
    padding: 0 58px;
}

.logo {
    flex-direction: row;
    align-items: center;
    margin-right: 62px;
}

.logo > Label {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 40px;
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
}

.logo > Label.turn {
    color: rgb(255, 122, 60);
    margin-left: 10px;
}

.sekmeler {
    flex-direction: row;
    align-items: center;
}

.sekme {
    height: 46px;
    padding: 0 25px;
    margin: 0 6px;
    justify-content: center;
}

.sekme > Label.yazi {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(201, 210, 216);
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
}

.sekme > .skew {
    --fill: rgba(0, 0, 0, 0);
    --edge: rgba(0, 0, 0, 0);
}

.sekme:hover > .skew {
    --fill: rgba(255, 255, 255, 0.06);
    --edge: rgba(255, 122, 60, 0.7);
}

.sekme:hover > Label.yazi {
    color: rgb(255, 255, 255);
}

.sekme.sec > .skew {
    --fill: rgb(255, 122, 60);
    --edge: rgba(255, 176, 112, 0.9);
}

.sekme.sec > Label.yazi {
    color: rgb(26, 13, 5);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.mini {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.mini > Label {
    -unity-font-definition: url("Fonts/Barlow-SemiBold.ttf");
    font-size: 19px;
    margin: 0 0 0 14px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
}

.sv {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background-color: rgb(255, 122, 60);
    align-items: center;
    justify-content: center;
}

.sv > Label {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 22px;
    color: rgb(26, 13, 5);
    margin: 0;
    padding: 0;
}

.ayrac {
    width: 1px;
    height: 30px;
    background-color: rgba(255, 255, 255, 0.25);
    margin-left: 14px;
}

/* bölüm başlığı: turuncu eğik çizgi + harf aralıklı küçük yazı */
.bb {
    flex-direction: row;
    align-items: center;
}

.bb > .cizgi {
    width: 17px;
    height: 5px;
    background-color: rgb(255, 122, 60);
    margin-right: 11px;
    rotate: -20deg;
}

.bb > Label {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 17px;
    letter-spacing: 3px;
    color: rgb(255, 122, 60);
    margin: 0;
    padding: 0;
}

.baslik {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 58px;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
}

/* cam panel */
.cam {
    background-color: rgba(11, 20, 24, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
    border-radius: 12px;
}

/* parçalı seçim (tür) */
.parcali {
    flex-direction: row;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    overflow: hidden;
}

.parca {
    padding: 0 26px;
    height: 44px;
    justify-content: center;
    background-color: rgba(11, 20, 24, 0.72);
    border-color: rgba(255, 255, 255, 0.13);
}

.parca.ayir {
    border-left-width: 1px;
}

.parca > Label {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 19px;
    letter-spacing: 1px;
    color: rgb(201, 210, 216);
    margin: 0;
}

.parca:hover {
    background-color: rgba(40, 48, 54, 0.9);
}

.parca.sec {
    background-color: rgb(255, 122, 60);
}

.parca.sec > Label {
    color: rgb(26, 13, 5);
}

/* kart */
.kart {
    background-color: rgba(11, 20, 24, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    padding: 17px 20px;
    justify-content: space-between;
    transition-property: translate, border-color;
    transition-duration: 0.12s;
}

.kart:hover {
    border-color: rgba(255, 122, 60, 0.6);
}

.kart.sec {
    border-width: 3px;
    border-color: rgb(255, 122, 60);
    background-color: rgba(30, 22, 16, 0.88);
    translate: 0 -12px;
}

.kart.kilit {
    opacity: 0.5;
}

.kart > Label.ust {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 2px;
    color: rgb(152, 164, 174);
    margin: 0;
}

.kart.sec > Label.ust {
    color: rgb(255, 122, 60);
}

.kart > Label.ad {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 30px;
    margin: 0;
    white-space: normal;
}

.kart > .alt {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.kart > .alt > Label {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    font-size: 16px;
    color: rgb(201, 210, 216);
    margin: 0;
}

.yildizlar {
    flex-direction: row;
}

.yildiz {
    width: 19px;
    height: 19px;
    margin-left: 5px;
}

/* durum satırı */
.durum {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    font-size: 17px;
    color: rgb(207, 215, 220);
    white-space: normal;
}

/* yarış HUD'u (panelsiz) */
.hud-baslik {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 19px;
    letter-spacing: 3px;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
}

.hud-bilgi {
    -unity-font-definition: url("Fonts/Barlow-SemiBold.ttf");
    font-size: 16px;
    margin: 2px 0 0 0;
    padding: 0;
    color: rgb(238, 242, 244);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
    white-space: normal;
}

.hud-sure {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 66px;
    -unity-text-align: upper-center;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.75);
}

.hud-alt {
    -unity-font-definition: url("Fonts/Barlow-SemiBold.ttf");
    font-size: 18px;
    -unity-text-align: upper-center;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
}

.hud-hiz {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
}

.hud-hiz-deger {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 96px;
    margin: 0;
    padding: 0;
    -unity-text-align: lower-right;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.75);
}

.hud-vites {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 42px;
    color: rgb(255, 122, 60);
    margin: 0 0 12px 8px;
    padding: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
}

.hud-birim {
    -unity-font-definition: url("Fonts/Barlow-SemiBold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-align: upper-right;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
}

.hud-orta {
    position: absolute;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85);
}

.hud-ipucu {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    font-size: 16px;
    color: rgb(219, 226, 231);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
    margin: 0;
}

/* ana menü: dört büyük eğik seçenek */
.logo-buyuk > Label {
    font-size: 96px;
}

.anasecim {
    height: 150px;
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 16px;
    padding: 0 44px;
    justify-content: center;
}

.anasecim > .skew {
    --fill: rgba(11, 20, 24, 0.86);
    --edge: rgba(255, 255, 255, 0.13);
}

.anasecim:hover > .skew {
    --fill: rgba(30, 38, 44, 0.94);
    --edge: rgb(255, 122, 60);
}

.anasecim.sec > .skew {
    --fill: rgb(255, 122, 60);
    --edge: rgba(255, 176, 112, 0.9);
}

.anasecim > Label.ad {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 50px;
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
}

.anasecim > Label.alt {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    font-size: 18px;
    color: rgb(201, 210, 216);
    margin: 4px 0 0 0;
    padding: 0;
}

.anasecim > Label.no {
    position: absolute;
    top: 16px;
    right: 40px;
}

.anasecim.sec > Label.ad,
.anasecim.sec > Label.alt {
    color: rgb(26, 13, 5);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.anasecim.sec > Label.no {
    color: rgb(26, 13, 5);
    border-color: rgba(26, 13, 5, 0.5);
    background-color: rgba(255, 255, 255, 0.2);
}

/* profil hapı */
.profil {
    flex-direction: row;
    align-items: center;
    padding: 12px 24px 12px 12px;
    border-radius: 60px;
}

.profil > .sv {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin-right: 16px;
}

.profil > .sv > Label {
    font-size: 28px;
}

.profil Label.ad {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    margin: 0;
}

.xpcubuk {
    width: 190px;
    height: 7px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.18);
    margin: 6px 0;
    overflow: hidden;
}

.xpcubuk > VisualElement {
    height: 100%;
    background-color: rgb(255, 122, 60);
}

.profil Label.alt {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    font-size: 16px;
    color: rgb(201, 210, 216);
    margin: 0;
}

/* Mutant: ayrı oyun tonu */
.mut-ton {
    background-color: rgba(70, 10, 4, 0.45);
}

.mut-ad {
    height: 44px;
    padding: 0 26px;
    justify-content: center;
    margin-right: 24px;
}

.mut-ad > .skew {
    --fill: rgb(255, 122, 60);
    --edge: rgba(255, 176, 112, 0.9);
}

.mut-ad > Label {
    -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    font-size: 28px;
    letter-spacing: 5px;
    color: rgb(26, 13, 5);
    margin: 0;
}

.kv {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.kv > Label {
    -unity-font-definition: url("Fonts/Barlow-Medium.ttf");
    font-size: 18px;
    color: rgb(152, 164, 174);
    margin: 0;
}

.kv > Label.deger {
    -unity-font-definition: url("Fonts/Barlow-SemiBold.ttf");
    color: rgb(255, 255, 255);
}

/* onay penceresi */
.perde {
    background-color: rgba(4, 6, 8, 0.72);
    align-items: center;
    justify-content: center;
}

.onay {
    width: 780px;
    padding: 38px 42px;
    border-top-width: 5px;
    border-top-color: rgb(255, 122, 60);
}

/* P7-2 Garaj / Modifiye: ekranlar-f.html §1–2, 1920×1080 başvuru. */
.g-content { position:absolute; left:0; right:0; top:150px; bottom:78px; }
.g-panel { background-color:rgba(11,20,24,.88); border-width:1px; border-color:rgba(255,255,255,.13); border-radius:10px; padding:22px; }
.g-left { position:absolute; left:58px; top:20px; width:380px; }
.g-right { position:absolute; right:58px; top:20px; width:420px; }
.g-name { font-size:42px; white-space:normal; margin-bottom:12px; }
.g-copy { white-space:normal; font-size:18px; margin-top:7px; margin-bottom:7px; color:rgb(195,207,216); }
.g-numeric { font-size:16px; margin-top:3px; margin-bottom:3px; }
.g-class { font-size:30px; -unity-font-definition:url("Fonts/BarlowCondensed-Bold.ttf"); margin-top:10px; margin-bottom:12px; }
.g-money { flex-grow:1; -unity-text-align:middle-right; font-size:23px; }
.g-preview { position:absolute; left:410px; right:450px; top:10px; bottom:240px; }
.g-actions { position:absolute; right:58px; bottom:210px; flex-direction:row; }
.g-actions > .ltb { margin-left:20px; }
.g-cars { position:absolute; left:58px; right:58px; bottom:24px; height:174px; }
.g-car { width:260px; margin-right:18px; flex-shrink:0; }
.g-car .ad { font-size:26px; }
.g-car .g-copy { font-size:15px; }
.g-message { position:absolute; left:300px; right:450px; bottom:26px; font-size:18px; white-space:normal; color:rgb(255,210,122); }
.g-mods { position:absolute; left:58px; right:58px; top:0; bottom:8px; flex-direction:row; }
.g-categories { width:295px; flex-shrink:0; margin-right:28px; }
.g-categories .sekme { height:48px; margin-bottom:7px; }
.g-categories .sekme .yazi { font-size:21px; }
.g-parts { flex-grow:1; flex-basis:0; margin-right:28px; }
.g-part { margin-top:14px; margin-bottom:14px; min-height:145px; }
.g-part .ad { font-size:28px; }
.g-effect { width:475px; flex-shrink:0; padding:24px; background-color:rgba(11,20,24,.94); border-radius:10px; }
.g-effect .ltb { margin-top:22px; height:70px; }
.g-effect .ltb .yazi { font-size:21px; }
.g-packages { flex-direction:row; flex-wrap:wrap; margin-top:12px; margin-bottom:20px; }
.g-packages .ltb { height:45px; padding-left:12px; padding-right:12px; margin-right:8px; margin-bottom:8px; }
.g-packages .ltb .yazi { font-size:17px; }
.g-price { color:rgb(255,210,122); font-size:20px; }
.g-bar { height:6px; background-color:rgb(45,56,64); margin-bottom:6px; margin-top:2px; }
.g-fill { height:6px; background-color:rgb(255,122,60); }
.g-mark { position:absolute; width:3px; top:-3px; height:12px; background-color:white; }
.g-stat { font-size:18px; white-space:normal; margin-top:13px; margin-bottom:6px; }
.g-content .unity-scroll-view__content-container { flex-grow:1; }
.g-content .unity-scroller { background-color:rgb(17,24,30); }
.g-content .unity-base-slider__tracker { background-color:rgb(35,45,54); }
.g-content .unity-base-slider__dragger { background-color:rgb(93,109,122); }
.g-content .unity-scroller__low-button, .g-content .unity-scroller__high-button { background-color:rgb(35,45,54); }
.g-right { padding-top:18px; padding-bottom:12px; }
.g-right .g-stat { margin-top:8px; }
/* P7-3 Mağaza F §3: aynı sekmeler, katalog vitrini ve satın alma paneli. */
.s-content { position:absolute; left:58px; right:58px; top:170px; bottom:96px; flex-direction:row; }
.s-featured { width:650px; margin-right:55px; flex-shrink:0; }
.s-featured .g-name { font-size:42px; margin-bottom:0; }
.s-featured .g-class { font-size:25px; margin-top:6px; margin-bottom:4px; }
.s-preview { flex-grow:1; flex-basis:0; flex-shrink:1; min-height:100px; }
.s-featured .g-panel { padding:18px; }
.s-stat { font-size:18px; margin-bottom:4px; }
.s-featured .ltb { margin-top:12px; height:60px; }
.s-featured .ltb .yazi { font-size:23px; }
.s-catalog { flex-grow:1; flex-basis:0; }
.s-tabs { flex-direction:row; margin-bottom:16px; }
.s-tabs .sekme { width:190px; margin-right:16px; }
.s-filters { flex-direction:row; flex-wrap:wrap; margin-bottom:12px; }
.s-filters .sekme { height:42px; padding-left:12px; padding-right:12px; margin-right:8px; margin-bottom:8px; }
.s-filters .yazi { font-size:18px; }
.s-scroll { flex-grow:1; flex-basis:0; }
.s-grid { flex-direction:row; flex-wrap:wrap; }
.s-car { width:30%; min-height:166px; margin-right:3%; margin-bottom:20px; padding:17px; }
.s-car .ad { font-size:26px; white-space:normal; }
.s-car .g-price { font-size:19px; }
.s-content .unity-scroller { background-color:rgb(17,24,30); }
.s-content .unity-base-slider__tracker { background-color:rgb(35,45,54); }
.s-content .unity-base-slider__dragger { background-color:rgb(93,109,122); }
.s-content .unity-scroller__low-button, .s-content .unity-scroller__high-button { background-color:rgb(35,45,54); }
/* P7-4 Mutant başlangıcı F §5c–d; mevcut koyu/turuncu bileşenler. */
.m-content { position:absolute; left:58px; right:58px; top:150px; bottom:100px; }
.m-steps { position:absolute; right:0; top:-92px; flex-direction:row; align-items:center; }
.m-steps Label { font-size:22px; }
.m-boss { position:absolute; left:0; top:20px; width:580px; height:440px; }
.m-selected { position:absolute; left:640px; right:0; top:20px; }
.m-selected .ltb { margin-top:24px; align-self:flex-start; }
.m-car-title { position:absolute; left:700px; right:0; top:110px; }
.m-car-title .baslik { font-size:68px; white-space:normal; }
.m-lower { position:absolute; left:0; right:0; bottom:0; }
.m-cards { flex-direction:row; margin-top:28px; }
.m-card { flex-grow:1; flex-basis:0; height:270px; margin-right:22px; }
.m-card .ad { font-size:34px; white-space:normal; }
.m-card .g-copy { font-size:20px; }
.m-card .t { position:absolute; right:14px; bottom:14px; }
.m-go { width:300px; height:270px; flex-shrink:0; }
.m-go .yazi { font-size:27px; }
.m-start-reward.sec { background-color:rgb(38,29,25); }
.m-start-key { position:absolute; right:12px; bottom:10px; color:rgb(255,122,60); font-size:17px; }
.m-reward-go { margin-left:20px; }
.m-content .ipuclari { bottom:-70px; right:0; }
.m-boss .unity-scroll-view__content-container { width:100%; }
.m-content .unity-scroller { background-color:rgb(17,24,30); }
.m-content .unity-base-slider__tracker { background-color:rgb(35,45,54); }
.m-content .unity-base-slider__dragger { background-color:rgb(93,109,122); }
.m-content .unity-scroller__low-button, .m-content .unity-scroller__high-button { background-color:rgb(35,45,54); }
/* F §4 Yarış hazırlığı. */
.r-content { position:absolute; left:58px; right:58px; top:170px; bottom:100px; flex-direction:row; }
.r-left { flex-grow:1; flex-basis:0; margin-right:70px; }
.r-title { font-size:65px; white-space:normal; }
.r-track-row { flex-direction:row; margin-top:32px; height:370px; }
.r-map { flex-grow:1; flex-basis:0; background-color:rgb(12,21,26); border-radius:10px; margin-right:25px; }
.r-targets { width:400px; }
.r-stat { font-size:26px; margin-top:16px; margin-bottom:18px; }
.r-reward { margin-top:25px; }
.r-options { width:610px; flex-shrink:0; align-self:flex-start; padding:30px; }
.r-options .bb { margin-top:22px; }
.r-options .ltb { margin-top:20px; }
.r-options .g-copy { min-height:48px; }
.r-chips { flex-direction:row; margin-top:16px; margin-bottom:18px; }
.r-chips .sekme { flex-grow:1; flex-basis:0; padding-left:12px; padding-right:12px; }
.r-chips .yazi { font-size:23px; }
/* F §6 Profil ve bulut hesabı. */
.p-content { position:absolute; left:58px; right:58px; top:170px; bottom:105px; flex-direction:row; }
.p-left { flex-grow:1; flex-basis:0; margin-right:60px; }
.p-identity { flex-direction:row; margin-bottom:40px; }
.p-ring { width:220px; height:220px; flex-shrink:0; align-items:center; justify-content:center; margin-right:32px; }
.p-ring .baslik { font-size:76px; }
.p-name { flex-grow:1; flex-basis:0; }
.p-name .ltb { align-self:flex-start; margin-top:18px; }
.p-cards { flex-direction:row; margin-bottom:35px; }
.p-cards .kart { flex-grow:1; flex-basis:0; margin-right:15px; height:165px; padding:17px; }
.p-cards .ad { font-size:27px; white-space:normal; }
.p-cloud { width:650px; flex-shrink:0; padding:28px; }
.p-cloud .unity-scroll-view__content-container { width:100%; }
.p-status { font-size:23px; white-space:normal; margin-top:16px; margin-bottom:12px; }
.p-field { flex-direction:column; margin-top:13px; margin-bottom:12px; font-size:22px; }
.p-field > .unity-text-field__label { min-width:0; margin-bottom:8px; font-size:18px; color:rgb(191,203,214); }
.p-field .unity-text-field__input { background-color:rgb(21,31,39); color:white; border-width:1px; border-color:rgb(75,88,98); padding:10px; min-height:46px; }
.p-field .unity-text-field__input:focus { border-color:rgb(255,122,60); }
.p-form .ltb { height:58px; margin-top:12px; }
.p-form .ltb .yazi { font-size:23px; }
.p-content .ltb:focus { border-color:rgb(255,122,60); border-width:2px; }
.p-content .unity-scroller { background-color:rgb(17,24,30); }
.p-content .unity-base-slider__tracker { background-color:rgb(35,45,54); }
.p-content .unity-base-slider__dragger { background-color:rgb(93,109,122); }
.p-content .unity-scroller__low-button, .p-content .unity-scroller__high-button { background-color:rgb(35,45,54); }
/* F §7 Ayarlar: bölüm listesi, satırlar, açıklama paneli; sahne kararır. */
.st-page { background-color:rgba(5,8,11,.86); }
.st-sections { position:absolute; left:58px; top:170px; width:290px; }
.st-sections .sekme { height:54px; margin:0 0 9px 0; justify-content:center; align-items:flex-start; padding-left:26px; }
.st-sections .sekme > .skew { --fill:rgba(11,20,24,.85); --edge:rgba(255,255,255,.13); }
.st-sections .sekme:hover > .skew { --fill:rgba(30,38,44,.94); --edge:rgb(255,122,60); }
.st-sections .sekme.sec > .skew { --fill:rgb(255,122,60); --edge:rgba(255,176,112,.9); }
.st-sections .sekme .yazi { font-size:23px; }
.st-main { position:absolute; left:390px; right:600px; top:170px; bottom:110px; }
.st-title { -unity-font-definition:url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); font-size:36px; color:rgb(255,255,255); margin-bottom:12px; }
.st-scroll { flex-grow:1; }
.st-row { flex-direction:row; align-items:center; min-height:64px; padding:8px 14px; margin-bottom:4px; border-left-width:3px; border-color:rgba(0,0,0,0); border-radius:4px; }
.st-row.sec { background-color:rgba(255,122,60,.16); border-left-color:rgb(255,122,60); }
.st-name { flex-grow:1; flex-shrink:1; -unity-font-definition:url("Fonts/Barlow-Medium.ttf"); font-size:21px; color:rgb(255,255,255); white-space:normal; margin-right:16px; }
.st-row .parca { padding:0 16px; height:42px; }
.st-row .parca > Label { font-size:18px; }
.st-slider { flex-direction:row; align-items:center; }
.st-slider .parca { width:44px; padding:0; align-items:center; border-width:1px; border-radius:6px; }
.st-track { width:300px; height:12px; margin:0 14px; border-radius:6px; }
.st-value { width:72px; -unity-text-align:middle-right; -unity-font-definition:url("Fonts/BarlowCondensed-Bold.ttf"); font-size:26px; color:rgb(255,255,255); }
.st-keys { margin-top:22px; }
.st-key { flex-direction:row; align-items:center; height:44px; padding:0 14px; border-bottom-width:1px; border-color:rgba(255,255,255,.07); }
.st-keycaps { flex-direction:row; }
.st-keycaps .t { margin-left:8px; }
.st-info { position:absolute; right:58px; top:170px; width:500px; }
.st-info .g-copy { font-size:20px; }
.st-main .unity-scroller { background-color:rgb(17,24,30); }
.st-main .unity-base-slider__tracker { background-color:rgb(35,45,54); }
.st-main .unity-base-slider__dragger { background-color:rgb(93,109,122); }
.st-main .unity-scroller__low-button, .st-main .unity-scroller__high-button { background-color:rgb(35,45,54); }
/* F §8 Duraklatma: solda işlemler, sağda durum ve hızlı ayar; sahne kararır. */
.pz-page { background-color:rgba(5,8,11,.72); }
.pz-page.mut-ton { background-color:rgba(40,8,4,.78); }
.pz-left { position:absolute; left:115px; top:150px; width:500px; }
.pz-where { white-space:normal; }
.pz-title { font-size:80px; margin-top:6px; }
.pz-actions { margin-top:26px; }
.pz-action { justify-content:space-between; margin-bottom:12px; }
.pz-action.sec > .skew { --fill:rgba(30,38,44,.94); --edge:rgb(255,122,60); }
.pz-action.ana.sec > .skew { --fill:rgb(255,122,60); --edge:rgb(255,214,180); }
.pz-right { position:absolute; right:115px; top:150px; width:580px; }
.pz-stats { flex-direction:row; margin-top:14px; margin-bottom:22px; }
.pz-stat { flex-grow:1; flex-basis:0; }
.pz-value { font-size:40px; color:rgb(255,255,255); }
.pz-quick .parcali { margin-bottom:14px; align-self:flex-start; }
.pz-quick .parca { padding:0 18px; }
/* F §9 Yarış sonucu: solda büyük süre ve yıldızlar, sağda sonuç ve kazanç, altta işlemler. */
.rs-page { background-color:rgba(5,8,11,.62); }
.rs-left { position:absolute; left:96px; top:134px; width:760px; }
.rs-value { -unity-font-definition:url("Fonts/BarlowCondensed-Bold.ttf"); font-size:134px; color:rgb(255,255,255); margin-top:4px; }
.rs-line { flex-direction:row; align-items:center; }
.rs-delta { -unity-font-definition:url("Fonts/Barlow-SemiBold.ttf"); font-size:25px; padding:2px 12px; border-radius:6px; background-color:rgba(255,255,255,.92); color:rgb(11,20,24); margin-right:16px; }
.rs-delta.kotu { background-color:rgb(255,210,122); }
.rs-record { -unity-font-definition:url("Fonts/BarlowCondensed-Bold.ttf"); font-size:19px; letter-spacing:2px; color:rgb(26,13,5); background-color:rgb(255,122,60); padding:3px 12px; border-radius:4px; margin-left:16px; }
.rs-header { font-size:22px; margin-top:16px; }
.rs-stars { flex-direction:row; margin-top:24px; }
.rs-star { align-items:center; margin-right:30px; }
.rs-star-icon { width:70px; height:70px; margin:0; }
.rs-right { position:absolute; right:96px; top:134px; width:580px; }
.rs-row { flex-direction:row; justify-content:space-between; align-items:center; height:42px; }
.rs-row-value { font-size:28px; color:rgb(255,255,255); }
.rs-sep { height:1px; background-color:rgba(255,255,255,.13); margin:16px 0; }
.rs-reward { -unity-font-definition:url("Fonts/BarlowCondensed-Bold.ttf"); font-size:40px; color:rgb(255,255,255); margin-top:8px; }
.rs-bar { flex-direction:row; height:12px; border-radius:6px; background-color:rgba(255,255,255,.14); overflow:hidden; margin-top:4px; }
.rs-fill { background-color:rgb(255,122,60); }
.rs-gain { background-color:rgb(255,208,181); }
.rs-actions { position:absolute; right:96px; bottom:96px; flex-direction:row; }
.rs-actions > .ltb { margin-left:22px; }
